* text=auto

# Shell scripts must stay LF on Windows checkouts (CRLF breaks shebang parsing).
*.sh   text eol=lf
*.bash text eol=lf

# Keep text data deterministic across platforms.
*.py   text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.svg  text eol=lf
*.json text eol=lf
LICENSE text eol=lf

*.png binary
*.jpg binary
*.zip binary
